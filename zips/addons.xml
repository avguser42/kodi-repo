<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="script.welcome.setup" name="Welcome Setup" version="1.0.0" provider-name="avguser42">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.service" library="default.py" start="login"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">First-run repository and addon installer</summary>
        <description lang="en_GB">Shows a setup wizard on first launch to install repositories, addons, and apply settings.</description>
        <platform>all</platform>
        <license>GPL-2.0-only</license>
    </extension>
</addon>
<addon id="repository.avguser42" name="avguser42 Repository" version="1.0.0" provider-name="avguser42">
    <extension point="xbmc.addon.repository" name="avguser42 Repository">
        <dir>
            <info compressed="false">https://avguser42.github.io/kodi-repo/zips/addons.xml</info>
            <checksum>https://avguser42.github.io/kodi-repo/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://avguser42.github.io/kodi-repo/zips/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">avguser42 Repository</summary>
        <description lang="en_GB">Repository for the Welcome Setup wizard.</description>
        <platform>all</platform>
        <license>GPL-2.0-only</license>
    </extension>
</addon>
</addons>
